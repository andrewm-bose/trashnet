# =============================================================================
# Denver Power Outage Monitor - Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# For GitHub Actions, set these as repository secrets/variables instead.

# --- Outage Criteria ---
# Minimum customers affected to trigger a notification
MIN_CUSTOMERS=100
# Minimum outage duration (hours) to trigger a notification
MIN_DURATION_HOURS=2.0

# --- Email/SMS Notifications (REQUIRED for notifications) ---
# Gmail: use smtp.gmail.com with an App Password (not your regular password)
# See: https://support.google.com/accounts/answer/185833
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your.email@gmail.com
SMTP_PASSWORD=your-app-password-here
FROM_EMAIL=your.email@gmail.com

# Comma-separated email addresses
EMAIL_RECIPIENTS=you@example.com,friend@example.com

# Comma-separated SMS-via-email addresses (free, no Twilio needed!)
# Format: phonenumber@carrier_gateway
# Carriers:
#   T-Mobile:  5551234567@tmomail.net
#   AT&T:      5551234567@txt.att.net
#   Verizon:   5551234567@vtext.com
#   Sprint:    5551234567@messaging.sprintpcs.com
#   US Cell:   5551234567@email.uscc.net
#   Metro PCS: 5551234567@mymetropcs.com
SMS_RECIPIENTS=5551234567@tmomail.net

# --- ntfy Push Notifications (OPTIONAL, replaces SMS) ---
# Free push notifications to your phone - no account needed!
# 1. Install the ntfy app (Android/iOS) or use the web UI
# 2. Subscribe to a topic (use something unique/secret)
# 3. Set the full URL below, e.g. https://ntfy.sh/my-secret-denver-outages
NTFY_TOPIC=
NTFY_PRIORITY=high

# --- Grocery Store Finder (OPTIONAL) ---
# Requires a Google Cloud account with Places API enabled
# Free tier: $200/month credit (more than enough for this)
GROCERY_SEARCH_ENABLED=false
GOOGLE_PLACES_API_KEY=
GROCERY_SEARCH_RADIUS=3000

# --- Logging ---
LOG_LEVEL=INFO
